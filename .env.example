# Copier vers .env puis remplacer les valeurs « changeme » :
#   openssl rand -hex 18        (mots de passe MongoDB)
#   openssl rand -base64 48     (JWT_SECRET)
#   openssl rand -base64 32     (INTEGRATION_ENCRYPTION_KEY)

MONGO_ROOT_USERNAME=pleasantstay_admin
MONGO_ROOT_PASSWORD=changeme
MONGO_APP_USERNAME=pleasantstay_app
MONGO_APP_PASSWORD=changeme
MONGO_DB_NAME=bd_pleasantstay

JWT_SECRET=changeme
INTEGRATION_ENCRYPTION_KEY=changeme

API_PORT=3002
BACKOFFICE_PORT=3006
FRONTOFFICE_PORT=3007
MOBILE_PORT=3008
MONGO_PORT=27017

# Registre npm utilisé pendant les builds Docker (miroir si besoin).
NPM_REGISTRY=https://registry.npmjs.org
