# Port de l'API
PORT=3000

# URI de connexion MongoDB
MONGODB_URI=mongodb://localhost:27017

# Nom de la base de données
MONGODB_DB_NAME=bd_pleasantstay

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:4200,http://localhost:3000,http://localhost:3001

# ========================
# AUTHENTIFICATION
# ========================

# Secret de signature des JWT (OBLIGATOIRE en production, longue chaîne aléatoire)
JWT_SECRET=change-me-with-a-long-random-secret
# Durée de vie du jeton d'accès (ex. 15m, 1h)
JWT_EXPIRES_IN=15m
# Durée de vie du refresh token / de la session (ex. 30d)
JWT_REFRESH_EXPIRES_IN=30d
# Durée de vie du jeton temporaire entre mot de passe et code 2FA
JWT_2FA_EXPIRES_IN=5m
# Émetteur des JWT (optionnel)
# JWT_ISSUER=pleasantstay-api

# Durées de validité des liens envoyés par email
AUTH_MAGIC_LINK_EXPIRES_IN=15m
AUTH_PASSWORD_RESET_EXPIRES_IN=1h
AUTH_EMAIL_VERIFICATION_EXPIRES_IN=24h

# Verrouillage du compte après N échecs de connexion
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=15m

# Coût bcrypt pour le hachage des mots de passe
AUTH_BCRYPT_ROUNDS=10

# Nom affiché dans l'application d'authentification (Google Authenticator…)
TWO_FACTOR_ISSUER=PleasantStay

# URL du frontend (construction des liens de réinitialisation / lien magique)
FRONTEND_URL=http://localhost:4200

# --- Bus d'intégration (ESB) ---
# Clé AES-256-GCM (32 octets en base64 ou hex) chiffrant les secrets des webhooks.
# Obligatoire en production. Générer : openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Autorise les URL locales/privées pour les webhooks (développement uniquement).
INTEGRATION_ALLOW_PRIVATE_URLS=false
# Désactive l'envoi périodique (cron) sur cette instance.
INTEGRATION_DISPATCHER_ENABLED=true
INTEGRATION_DISPATCH_BATCH_SIZE=50
INTEGRATION_AUTO_DISABLE_AFTER=50
# URL publique de l'API, pour afficher l'adresse complète des webhooks entrants.
INTEGRATION_PUBLIC_BASE_URL=

# --- Initialisation de la base (npm run seed) ---
SEED_ADMIN_EMAIL=admin@pleasantstay.local
# Sans valeur, un mot de passe aléatoire est généré et affiché une seule fois.
SEED_ADMIN_PASSWORD=
# false : n'insère pas l'hôtel de démonstration.
SEED_DEMO=true
